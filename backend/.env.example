# Convex / PROXY X API - environment template
# Copy to `.env.local` for `npx convex dev`, or set via:
#   npx convex env set --prod NAME value

# AI
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_NAME=...
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_X_TITLE=PROXY X

# Speech-to-text (Whisper) - free options, no PROXY paid plan needed:
#   Groq free tier (recommended): https://console.groq.com → API keys
#   GROQ_API_KEY=gsk_...
# Or OpenAI Whisper (paid usage after free credit):
#   OPENAI_API_KEY=sk-...
# Optional overrides:
# WHISPER_API_KEY=...
# WHISPER_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# WHISPER_MODEL=whisper-large-v3

# Stripe (server only - never ship to desktop/web clients)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# Alias also accepted by http.ts:
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# Auth (WorkOS)
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
WORKOS_ENVIRONMENT_ID=...
# WORKOS_SECRET=...
# WORKOS_SIGNATURE_SECRET=...

# Website base for checkout return URLs
PROXY_WEBSITE_URL=http://localhost:5173

# Deployment (convex CLI)
# CONVEX_DEPLOYMENT=prod:your-deployment
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
