# Must match the Convex deployment that serves /auth/* and account APIs
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Optional override; defaults to .convex.site derived from VITE_CONVEX_URL
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

VITE_WORKOS_CLIENT_ID=client_...
# Browser AuthKit return URL (web sign-in). Desktop uses Convex WORKOS_REDIRECT_URI.
# VITE_WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback
# Optional custom AuthKit domain (e.g. auth.getproxy.ca). Required for secure cookie sessions.
# Without it, the web app keeps you signed in via localStorage (devMode).
# VITE_WORKOS_API_HOSTNAME=auth.yourdomain.com
# Force localStorage sessions on/off (defaults: on when no API hostname)
# VITE_WORKOS_DEV_MODE=true

# Contact form (Resend) — server-only on Vercel / Vite middleware. Never use VITE_.
# Required:
RESEND_API_KEY=re_...
# Optional — leave unset:
#   CONTACT_TO_EMAIL   → defaults to contact@sterben.dev (inbox that receives form mail)
#   CONTACT_FROM_EMAIL → defaults to PROXY Contact <onboarding@resend.dev>
# "From" must be a Resend-allowed sender. Until you verify a domain in Resend,
# keep the default onboarding address. With that default, Resend only delivers
# to the email on your Resend account (so that account email should be
# contact@sterben.dev, or set CONTACT_TO_EMAIL to your Resend login email).
# After verifying getproxy.ca (or another domain): CONTACT_FROM_EMAIL=PROXY <noreply@getproxy.ca>
