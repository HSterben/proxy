# Production Convex (used by Vite builds and the main process).
# Copy to `.env` or `.env.local` and replace with your deployment URLs.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional local override: use `.env.local` (gitignored) to hit a Convex *dev*
# deployment while coding. Do not put GITHUB_TOKEN here; set it in the shell
# only when running npm run publish:win.
