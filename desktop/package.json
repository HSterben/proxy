    "electron-store": "^8.2.0",
    "katex": "^0.18.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "thinking-orbs": "^0.3.1",
    "update-electron-app": "^3.3.0",
    "voice-glow": "^0.2.0"
  }
