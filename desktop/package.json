  "version": "1.0.1",
  "description": "PROXY - AI chat assistant",
  "main": ".vite/build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSterben/Proxy.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform win32 --targets=@electron-forge/maker-squirrel,@electron-forge/maker-zip",
    "make:msix": "electron-forge make --platform win32 --targets=@electron-forge/maker-msix",
    "make:win:all": "electron-forge make --platform win32",
    "make:mac": "electron-forge make --platform darwin",
    "publish": "electron-forge publish",
    "publish:win": "electron-forge publish --platform win32",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Sterben",
    "email": "142906656+HSterben@users.noreply.github.com"
  },
  "license": "MIT",
